build a calculator function


def value(num1,s,num2):
      
      if s=="+":
        sum=num1+num2
        return sum
      elif s=="-": 
        sum=num1-num2
        return sum
      elif s=="*":
        sum=num1*num2
        return sum
      elif s=="/":
          if num2!=0:
            sum=num1/num2
            return sum
      else:
          print("math error")
          
        
n1=int(input("Enter 1st num:"))   
op=(input("Enter operator:"))
n2=int(input("Enter 2nd num:"))

result=value(n1,op,n2)
print("result:",result)
